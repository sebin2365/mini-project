# ─────────────────────────────────────────────────────────────
# 이 파일은 '견본'입니다. 진짜 키는 여기에 쓰지 마세요 (GitHub에 올라갑니다).
#   cp .env.example .env   →   .env 파일에만 진짜 키를 적으세요.
# ─────────────────────────────────────────────────────────────

# LangSmith (선택) — 키가 없으면 LANGCHAIN_TRACING_V2=false 로 두세요
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=safework-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# OpenAI (최종 테스트용, 과금) — LLM_BACKEND=openai 일 때만 필요
OPENAI_API_KEY=sk-...
# OPENAI_ANALYZER_MODEL=gpt-4o-mini
# OPENAI_WRITER_MODEL=gpt-4o-mini

# Ollama (개발용, 무료) — 메모리가 8GB면 OLLAMA_WRITER_MODEL=qwen3:1.7b 추천
# OLLAMA_ANALYZER_MODEL=qwen3:0.6b
# OLLAMA_WRITER_MODEL=qwen3:8b

# 1로 두면 PubChem에 접속하지 않고 로컬 캐시(data/chemicals_local.json)만 사용
# PUBCHEM_OFFLINE=1
